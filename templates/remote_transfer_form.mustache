{{!
    @template local_backupftp/remote_transfer_form

    Example context (json):
    {
        "actionurl": "https://moodle.local/local/backupftp/restore.php",
        "sesskey": "abc123",
        "remotewwwroot": "https://old.example.edu",
        "remoteip": "192.0.2.10",
        "remotetoken": "token",
        "remoteopen": true
    }
}}
<details class="card mb-4 local-backupftp-remote-transfer"{{#remoteopen}} open{{/remoteopen}}>
    <summary class="card-body d-flex align-items-center justify-content-between" style="cursor: pointer;">
        <h3 class="m-0">{{#str}}transfer_restore_title, local_backupftp{{/str}}</h3>
        <span aria-hidden="true" class="ml-2">▼</span>
    </summary>

    <div class="card-body border-top">
        <p>{{#str}}transfer_restore_desc, local_backupftp{{/str}}</p>

        <form method="post" action="{{{actionurl}}}">
            <input type="hidden" name="sesskey" value="{{{sesskey}}}">
            <input type="hidden" name="remotequeue" value="1">

            <div class="form-group">
                <label for="id_remotewwwroot">{{#str}}transfer_restore_wwwroot, local_backupftp{{/str}}</label>
                <input type="url"
                       name="remotewwwroot"
                       id="id_remotewwwroot"
                       class="form-control"
                       required="required"
                       value="{{{remotewwwroot}}}"
                       placeholder="https://moodle-antigo.exemplo.com.br">
                <small class="form-text text-muted">{{#str}}transfer_restore_wwwroot_desc, local_backupftp{{/str}}</small>
            </div>

            <div class="form-group">
                <label for="id_remoteip">{{#str}}transfer_restore_ip, local_backupftp{{/str}}</label>
                <input type="text"
                       name="remoteip"
                       id="id_remoteip"
                       class="form-control"
                       value="{{{remoteip}}}"
                       placeholder="192.0.2.10">
                <small class="form-text text-muted">{{#str}}transfer_restore_ip_desc, local_backupftp{{/str}}</small>
            </div>

            <div class="form-group">
                <label for="id_remotetoken">{{#str}}transfer_restore_token, local_backupftp{{/str}}</label>
                <input type="text"
                       name="remotetoken"
                       id="id_remotetoken"
                       class="form-control"
                       required="required"
                       value="{{{remotetoken}}}"
                       autocomplete="off">
                <small class="form-text text-muted">{{#str}}transfer_restore_token_desc, local_backupftp{{/str}}</small>
            </div>

            <input type="submit"
                   class="btn btn-primary"
                   value="{{#str}}transfer_restore_queue_button, local_backupftp{{/str}}">
        </form>
    </div>
</details>
