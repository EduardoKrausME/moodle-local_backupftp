{{!
    @template local_backupftp/run-task-result

    Example context (json):
    {
        "title": "Task completed",
        "text": "Log text",
        "error": false,
        "success": true,
        "backurl": "https://moodle.local/local/backupftp/run-task.php"
    }
}}
<div class="alert {{#error}}alert-danger{{/error}}{{#success}}alert-success{{/success}}" role="alert">
    <h3 class="h5">{{title}}</h3>
    <pre class="mb-0" style="max-height:70vh;overflow:auto;white-space:pre-wrap;">{{text}}</pre>
</div>
<p class="mt-3">
    <a href="{{{backurl}}}">{{#str}}back{{/str}}</a>
</p>
