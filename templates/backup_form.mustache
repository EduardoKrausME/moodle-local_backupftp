{{!
    @template local_backupftp/backup_form

    Example context (json):
    {
        "actionurl": "https://moodle.local/local/backupftp/backup.php",
        "sesskey": "abc123",
        "tree": "<div>...</div>"
    }
}}
<form method="post" action="{{{actionurl}}}">
    <input type="hidden" name="sesskey" value="{{{sesskey}}}">

    <h2>{{#str}}categories, local_backupftp{{/str}}</h2>
    <p class="text-muted">{{#str}}backup_category_select_help, local_backupftp{{/str}}</p>

    <div class="local-backupftp-tree" data-region="local-backupftp-tree">
        {{{tree}}}
        {{{categorias}}}
    </div>

    <input type="submit"
           class="btn btn-primary mt-3"
           value="{{#str}}submit, local_backupftp{{/str}}">
</form>
