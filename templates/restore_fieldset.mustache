{{!
    @template local_backupftp/restore_fieldset

    Example context (json):
    {
        "unique": "Aa123",
        "infocategori_link": "title",
        "data": "rows"
    }
}}

<div id="id-{{unique}}" class="local-backupftp-tree-node" data-region="local-backupftp-node">
    <div class="local-backupftp-tree-card">
        <div class="local-backupftp-tree-header">
            <div class="local-backupftp-tree-title">
                <span class="local-backupftp-tree-icon" aria-hidden="true">▣</span>
                <h5>{{{infocategori_link}}}</h5>
            </div>

            <div class="local-backupftp-tree-actions">
                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        data-action="local-backupftp-select-all">
                    {{#str}}select_all, local_backupftp{{/str}}
                </button>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        data-action="local-backupftp-deselect-all">
                    {{#str}}deselect_all, local_backupftp{{/str}}
                </button>
            </div>
        </div>

        <div class="local-backupftp-tree-body">
            {{{data}}}
        </div>
    </div>
</div>
