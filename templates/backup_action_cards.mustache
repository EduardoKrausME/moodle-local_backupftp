{{!
    @template local_backupftp/backup_action_cards

    Example context (json):
    {
        "reporturl": "https://moodle.local/local/backupftp/report-backup.php",
        "taskurl": "https://moodle.local/local/backupftp/run-task.php"
    }
}}
<div class="local-backupftp-page-links">
    <div class="local-backupftp-action-card">
        <h3>{{#str}}backup_report, local_backupftp{{/str}}</h3>
        <p>{{#str}}view_backup_report, local_backupftp{{/str}}</p>
        <a class="btn btn-outline-primary btn-sm" href="{{{reporturl}}}">{{#str}}report, local_backupftp{{/str}}</a>
    </div>

    <div class="local-backupftp-action-card">
        <h3>{{#str}}manual_cron_title, local_backupftp{{/str}}</h3>
        <p>{{#str}}manual_cron_desc, local_backupftp{{/str}}</p>
        <a class="btn btn-outline-secondary btn-sm" href="{{{taskurl}}}">{{#str}}manual_cron_button, local_backupftp{{/str}}</a>
    </div>
</div>
