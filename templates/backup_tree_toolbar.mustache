{{!
    @template local_backupftp/backup_tree_toolbar

    Example context (json):
    {}
}}
<div class="local-backupftp-tree-toolbar local-backupftp-tree-actions">
    <button type="button"
            class="btn btn-sm btn-outline-primary"
            data-action="local-backupftp-select-all">
        {{#str}}select_all, local_backupftp{{/str}}
    </button>
    <button type="button"
            class="btn btn-sm btn-outline-secondary"
            data-action="local-backupftp-deselect-all">
        {{#str}}deselect_all, local_backupftp{{/str}}
    </button>
</div>
