{{!
    @template local_backupftp/backup_category_node

    Example context (json):
    {
        "categoryid": 10,
        "inputid": "id-lbfcat_123",
        "name": "Category",
        "coursecount": 4,
        "statuses": [{"label": "waiting: 2"}],
        "haschildren": true,
        "children": "<div>...</div>"
    }
}}
<div class="local-backupftp-tree-node" data-region="local-backupftp-node">
    <div class="local-backupftp-tree-card">
        <div class="local-backupftp-tree-header">
            <div class="local-backupftp-tree-title">
                <input type="checkbox"
                       id="{{{inputid}}}"
                       name="category[{{{categoryid}}}]"
                       value="{{{categoryid}}}">
                <span class="local-backupftp-tree-icon" aria-hidden="true">▣</span>
                <div>
                    <h4><label for="{{{inputid}}}">{{{name}}}</label></h4>
                    <div class="local-backupftp-tree-meta">
                        <span class="badge badge-secondary">{{#str}}courses, local_backupftp{{/str}}: {{{coursecount}}}</span>
                        {{#statuses}}
                            <span class="badge badge-info">{{{label}}}</span>
                        {{/statuses}}
                    </div>
                </div>
            </div>

            <div class="local-backupftp-tree-actions">
                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        data-action="local-backupftp-select-all">
                    {{#str}}select_all, local_backupftp{{/str}}
                </button>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        data-action="local-backupftp-deselect-all">
                    {{#str}}deselect_all, local_backupftp{{/str}}
                </button>
            </div>
        </div>

        {{#haschildren}}
            <div class="local-backupftp-tree-body">
                <div class="local-backupftp-tree-children">
                    {{{children}}}
                </div>
            </div>
        {{/haschildren}}
    </div>
</div>
