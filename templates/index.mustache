{{!
    @template local_backupftp/index

    Example context (json):
    {
        "backupurl": "https://moodle.local/local/backupftp/backup.php",
        "restoreurl": "https://moodle.local/local/backupftp/restore.php",
        "tokensurl": "https://moodle.local/local/backupftp/tokens.php",
        "backupreporturl": "https://moodle.local/local/backupftp/report-backup.php",
        "restorereporturl": "https://moodle.local/local/backupftp/report-restore.php"
    }
}}

<div class="local-backupftp-index">
    <div class="alert alert-info mb-4">
        <h3 class="h5 mb-2">{{#str}}index_title, local_backupftp{{/str}}</h3>
        <p class="mb-0">
            {{#str}}index_intro_desc, local_backupftp{{/str}}
        </p>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="h5">{{#str}}index_backup_title, local_backupftp{{/str}}</h3>
                    <p>
                        {{#str}}index_backup_desc, local_backupftp{{/str}}
                    </p>
                    <p class="mb-0">
                        <a class="btn btn-primary" href="{{{backupurl}}}">{{#str}}index_backup_button, local_backupftp{{/str}}</a>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="h5">{{#str}}index_restore_title, local_backupftp{{/str}}</h3>
                    <p>
                        {{#str}}index_restore_desc_before_wwwroot, local_backupftp{{/str}}
                        <code>wwwroot</code>
                        {{#str}}index_restore_desc_after_wwwroot, local_backupftp{{/str}}
                    </p>
                    <p>
                        {{#str}}index_restore_queue_desc, local_backupftp{{/str}}
                    </p>
                    <p class="mb-0">
                        <a class="btn btn-primary" href="{{{restoreurl}}}">{{#str}}index_restore_button, local_backupftp{{/str}}</a>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-12 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="h5">{{#str}}transfer_tokens, local_backupftp{{/str}}</h3>
                    <p>
                        {{#str}}index_tokens_desc_before_mbz, local_backupftp{{/str}}
                        <code>.mbz</code>.
                        {{#str}}index_tokens_desc_after_mbz, local_backupftp{{/str}}
                    </p>

                    <div class="card-body">
                        <h3 class="h5 mb-3">{{#str}}index_recommended_flow_title, local_backupftp{{/str}}</h3>
                        <ol class="mb-0">
                            <li>
                                {{#str}}index_flow_step_moodle, local_backupftp{{/str}}
                                <strong>{{#str}}index_old_moodle, local_backupftp{{/str}}</strong>,
                                {{#str}}index_flow_step1_after_old_moodle, local_backupftp{{/str}}
                            </li>
                            <li>
                                {{#str}}index_flow_step2_before_token, local_backupftp{{/str}}
                                <strong>{{#str}}index_transfer_token, local_backupftp{{/str}}</strong>.
                                {{#str}}index_flow_step2_after_token_before_mbz, local_backupftp{{/str}}
                                <code>.mbz</code>
                                {{#str}}index_flow_step2_after_mbz, local_backupftp{{/str}}
                            </li>
                            <li>
                                {{#str}}index_flow_step_moodle, local_backupftp{{/str}}
                                <strong>{{#str}}index_new_moodle, local_backupftp{{/str}}</strong>,
                                {{#str}}index_flow_step3_after_new_moodle_before_wwwroot, local_backupftp{{/str}}
                                <code>wwwroot</code>
                                {{#str}}index_flow_step3_after_wwwroot, local_backupftp{{/str}}
                            </li>
                            <li>
                                {{#str}}index_flow_step4, local_backupftp{{/str}}
                            </li>
                        </ol>
                    </div>
                    <p class="mb-0">
                        <a class="btn btn-primary" href="{{{tokensurl}}}">{{#str}}index_tokens_button, local_backupftp{{/str}}</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-warning mb-4">
        <h3 class="h6 mb-2">{{#str}}index_token_time_title, local_backupftp{{/str}}</h3>
        <p class="mb-0">
            {{#str}}index_token_time_desc, local_backupftp{{/str}}
        </p>
    </div>

    <div class="card">
        <div class="card-body">
            <h3 class="h5 mb-3">{{#str}}index_reports_title, local_backupftp{{/str}}</h3>
            <p>
                {{#str}}index_reports_desc, local_backupftp{{/str}}
            </p>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <a class="btn btn-outline-primary" href="{{{backupreporturl}}}">{{#str}}index_backup_report_button, local_backupftp{{/str}}</a>
                </div>
                <div class="col-md-6 mb-2">
                    <a class="btn btn-outline-primary" href="{{{restorereporturl}}}">{{#str}}index_restore_report_button, local_backupftp{{/str}}</a>
                </div>
            </div>
        </div>
    </div>
</div>
