{{!
    @template local_backupftp/restore_form

    Example context (json):
    {
        "actionurl": "http://moodle/restore.php",
        "sesskey": "abc",
        "list_files_ftp": "file...",
        "list_files_local": "file..."
    }
}}

<form method="post" action="{{{actionurl}}}">
    <input type="hidden" name="sesskey" value="{{{sesskey}}}">

    <p class="text-muted">{{#str}}restore_file_select_help, local_backupftp{{/str}}</p>

    <h2>{{#str}}settings_ftp, local_backupftp{{/str}}</h2>
    <div class="local-backupftp-tree" data-region="local-backupftp-tree">
        <div class="local-backupftp-tree-toolbar local-backupftp-tree-actions">
            <button type="button" class="btn btn-sm btn-outline-primary" data-action="local-backupftp-select-all">
                {{#str}}select_all, local_backupftp{{/str}}
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="local-backupftp-deselect-all">
                {{#str}}deselect_all, local_backupftp{{/str}}
            </button>
        </div>
        {{{list_files_ftp}}}
    </div>

    <hr>

    <h2>{{#str}}settings_local, local_backupftp{{/str}}</h2>
    <div class="local-backupftp-tree" data-region="local-backupftp-tree">
        <div class="local-backupftp-tree-toolbar local-backupftp-tree-actions">
            <button type="button" class="btn btn-sm btn-outline-primary" data-action="local-backupftp-select-all">
                {{#str}}select_all, local_backupftp{{/str}}
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="local-backupftp-deselect-all">
                {{#str}}deselect_all, local_backupftp{{/str}}
            </button>
        </div>
        {{{list_files_local}}}
    </div>

    <br>
    <input class="btn btn-primary" type="submit" value="{{#str}}submit, local_backupftp{{/str}}">
</form>
