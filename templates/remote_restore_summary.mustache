{{!
    @template local_backupftp/remote_restore_summary

    Example context (json):
    {
        "actionurl": "https://moodle.local/local/backupftp/restore.php",
        "sesskey": "abc123",
        "hascounter": true,
        "countdown": "<span>...</span>",
        "tablerows": []
    }
}}
<div class="card mb-4 local-backupftp-remote-summary alert alert-success">
    <div class="card-body">
        <p>{{#str}}transfer_restore_session_summary, local_backupftp{{/str}}</p>
        {{#hascounter}}
            <p>{{#str}}transfer_restore_token_counter, local_backupftp{{/str}} {{{countdown}}}</p>
        {{/hascounter}}

        <form method="post" action="{{{actionurl}}}">
            <input type="hidden" name="sesskey" value="{{{sesskey}}}">
            <input type="hidden" name="remoterestoremarked" value="1">

            <div class="local-backupftp-tree" data-region="local-backupftp-tree">
                <div class="local-backupftp-tree-toolbar local-backupftp-tree-actions mb-2">
                    <button type="button"
                            class="btn btn-sm btn-outline-primary"
                            data-action="local-backupftp-select-all">
                        {{#str}}select_all, local_backupftp{{/str}}
                    </button>
                </div>

                <table class="generaltable table table-striped">
                    <thead>
                    <tr>
                        <th>{{#str}}transfer_restore_select_file, local_backupftp{{/str}}</th>
                        <th>{{#str}}filename, backup{{/str}}</th>
                        <th>{{#str}}transfer_restore_original_course, local_backupftp{{/str}}</th>
                        <th>{{#str}}transfer_restore_original_category, local_backupftp{{/str}}</th>
                        <th>{{#str}}file_size_label, local_backupftp{{/str}}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#tablerows}}
                        <tr>
                            <td>
                                <input type="checkbox"
                                       name="remotefile[]"
                                       value="{{{relativepath}}}"
                                       aria-label="{{#str}}transfer_restore_select_file, local_backupftp{{/str}}">
                            </td>
                            <td>
                                <div><strong>{{{filename}}}</strong></div>
                                <div><small><strong>{{#str}}remote_file, local_backupftp{{/str}}</strong>: {{{relativepath}}}</small></div>
                            </td>
                            <td>
                                {{#hascourse}}
                                    {{#courseid}}{{{courseid}}} - {{/courseid}}{{{coursefullname}}}
                                {{/hascourse}}
                                {{^hascourse}}-{{/hascourse}}
                            </td>
                            <td>
                                {{#hascategory}}
                                    {{#categoryid}}{{{categoryid}}} - {{/categoryid}}{{{categoryname}}}
                                {{/hascategory}}
                                {{^hascategory}}-{{/hascategory}}
                            </td>
                            <td>{{{filesize}}}</td>
                        </tr>
                    {{/tablerows}}
                    </tbody>
                </table>
            </div>

            {{#limited}}
                <p>{{#str}}transfer_restore_table_limited, local_backupftp{{/str}}</p>
            {{/limited}}

            <div class="mt-3 d-flex flex-wrap align-items-center">
                <input type="submit"
                       class="btn btn-primary mr-2 mb-2"
                       value="{{#str}}transfer_restore_selected_button, local_backupftp{{/str}}">
                <button type="submit"
                        name="remoteclear"
                        value="1"
                        class="btn btn-secondary mb-2">
                    {{#str}}transfer_restore_clear_session_button, local_backupftp{{/str}}
                </button>
            </div>
        </form>
    </div>
</div>
